generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AccountState {
  AccountStateID                               Int       @id @default(autoincrement())
  StateName                                    String    @db.VarChar(100)
  CreatedAt                                    DateTime  @default(now()) @db.DateTime(0)
  CreatedBy                                    Int?
  ModifiedAt                                   DateTime? @db.DateTime(0)
  ModifiedBy                                   Int?
  AppUser_AccountState_CreatedByToAppUser      AppUser?  @relation("AccountState_CreatedByToAppUser", fields: [CreatedBy], references: [UserID], map: "FK_AccountState_CreatedBy")
  AppUser_AccountState_ModifiedByToAppUser     AppUser?  @relation("AccountState_ModifiedByToAppUser", fields: [ModifiedBy], references: [UserID], map: "FK_AccountState_ModifiedBy")
  AppUser_AppUser_AccountStateIDToAccountState AppUser[] @relation("AppUser_AccountStateIDToAccountState")

  @@index([CreatedBy], map: "FK_AccountState_CreatedBy")
  @@index([ModifiedBy], map: "FK_AccountState_ModifiedBy")
}

model Admin {
  AdminID                           Int       @id
  IsSuperAdmin                      Boolean   @default(false)
  CreatedAt                         DateTime  @default(now()) @db.DateTime(0)
  CreatedBy                         Int?
  ModifiedAt                        DateTime? @db.DateTime(0)
  ModifiedBy                        Int?
  AppUser_Admin_AdminIDToAppUser    AppUser   @relation("Admin_AdminIDToAppUser", fields: [AdminID], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Admin_AppUser")
  AppUser_Admin_CreatedByToAppUser  AppUser?  @relation("Admin_CreatedByToAppUser", fields: [CreatedBy], references: [UserID], map: "FK_Admin_CreatedBy")
  AppUser_Admin_ModifiedByToAppUser AppUser?  @relation("Admin_ModifiedByToAppUser", fields: [ModifiedBy], references: [UserID], map: "FK_Admin_ModifiedBy")

  @@index([CreatedBy], map: "FK_Admin_CreatedBy")
  @@index([ModifiedBy], map: "FK_Admin_ModifiedBy")
}

model AppUser {
  UserID                                                            Int                      @id @default(autoincrement())
  FirstName                                                         String                   @db.VarChar(100)
  LastName                                                          String                   @db.VarChar(100)
  UserName                                                          String                   @unique(map: "UserName") @db.VarChar(100)
  Email                                                             String                   @unique(map: "Email") @db.VarChar(150)
  Password                                                          String                   @db.VarChar(255)
  RegisteredAt                                                      DateTime                 @default(now()) @db.DateTime(0)
  IsAdmin                                                           Boolean                  @default(false)
  NumberPublications                                                Int                      @default(0)
  MongoDocumentID                                                   String?                  @db.VarChar(255)
  CreatedAt                                                         DateTime                 @default(now()) @db.DateTime(0)
  CreatedBy                                                         Int?
  ModifiedAt                                                        DateTime?                @db.DateTime(0)
  ModifiedBy                                                        Int?
  GenderID                                                          Int
  CountryID                                                         Int
  AccountStateID                                                    Int
  AccountState_AccountState_CreatedByToAppUser                      AccountState[]           @relation("AccountState_CreatedByToAppUser")
  AccountState_AccountState_ModifiedByToAppUser                     AccountState[]           @relation("AccountState_ModifiedByToAppUser")
  Admin_Admin_AdminIDToAppUser                                      Admin?                   @relation("Admin_AdminIDToAppUser")
  Admin_Admin_CreatedByToAppUser                                    Admin[]                  @relation("Admin_CreatedByToAppUser")
  Admin_Admin_ModifiedByToAppUser                                   Admin[]                  @relation("Admin_ModifiedByToAppUser")
  AccountState_AppUser_AccountStateIDToAccountState                 AccountState             @relation("AppUser_AccountStateIDToAccountState", fields: [AccountStateID], references: [AccountStateID], onDelete: NoAction, onUpdate: NoAction, map: "FK_AppUser_AccountState")
  Country_AppUser_CountryIDToCountry                                Country                  @relation("AppUser_CountryIDToCountry", fields: [CountryID], references: [CountryID], onDelete: NoAction, onUpdate: NoAction, map: "FK_AppUser_Country")
  AppUser_AppUser_CreatedByToAppUser                                AppUser?                 @relation("AppUser_CreatedByToAppUser", fields: [CreatedBy], references: [UserID], map: "FK_AppUser_CreatedBy")
  other_AppUser_AppUser_CreatedByToAppUser                          AppUser[]                @relation("AppUser_CreatedByToAppUser")
  Gender_AppUser_GenderIDToGender                                   Gender                   @relation("AppUser_GenderIDToGender", fields: [GenderID], references: [GenderID], onDelete: NoAction, onUpdate: NoAction, map: "FK_AppUser_Gender")
  AppUser_AppUser_ModifiedByToAppUser                               AppUser?                 @relation("AppUser_ModifiedByToAppUser", fields: [ModifiedBy], references: [UserID], map: "FK_AppUser_ModifiedBy")
  other_AppUser_AppUser_ModifiedByToAppUser                         AppUser[]                @relation("AppUser_ModifiedByToAppUser")
  Boycott_Boycott_CheckedByToAppUser                                Boycott[]                @relation("Boycott_CheckedByToAppUser")
  Boycott_Boycott_CreatedByToAppUser                                Boycott[]                @relation("Boycott_CreatedByToAppUser")
  Boycott_Boycott_CreatorIDToAppUser                                Boycott[]                @relation("Boycott_CreatorIDToAppUser")
  Boycott_Boycott_ModifiedByToAppUser                               Boycott[]                @relation("Boycott_ModifiedByToAppUser")
  BoycottState_BoycottState_CreatedByToAppUser                      BoycottState[]           @relation("BoycottState_CreatedByToAppUser")
  BoycottState_BoycottState_ModifiedByToAppUser                     BoycottState[]           @relation("BoycottState_ModifiedByToAppUser")
  CategoryEntity_CategoryEntity_CreatedByToAppUser                  CategoryEntity[]         @relation("CategoryEntity_CreatedByToAppUser")
  CategoryEntity_CategoryEntity_ModifiedByToAppUser                 CategoryEntity[]         @relation("CategoryEntity_ModifiedByToAppUser")
  CommentBoycott_CommentBoycott_CreatedByToAppUser                  CommentBoycott[]         @relation("CommentBoycott_CreatedByToAppUser")
  CommentBoycott_CommentBoycott_CreatorIDToAppUser                  CommentBoycott[]         @relation("CommentBoycott_CreatorIDToAppUser")
  CommentBoycott_CommentBoycott_ModifiedByToAppUser                 CommentBoycott[]         @relation("CommentBoycott_ModifiedByToAppUser")
  CommentState_CommentState_CreatedByToAppUser                      CommentState[]           @relation("CommentState_CreatedByToAppUser")
  CommentState_CommentState_ModifiedByToAppUser                     CommentState[]           @relation("CommentState_ModifiedByToAppUser")
  Continent_Continent_CreatedByToAppUser                            Continent[]              @relation("Continent_CreatedByToAppUser")
  Continent_Continent_ModifiedByToAppUser                           Continent[]              @relation("Continent_ModifiedByToAppUser")
  Country_Country_CreatedByToAppUser                                Country[]                @relation("Country_CreatedByToAppUser")
  Country_Country_ModifiedByToAppUser                               Country[]                @relation("Country_ModifiedByToAppUser")
  Entity_Entity_CreatedByToAppUser                                  Entity[]                 @relation("Entity_CreatedByToAppUser")
  Entity_Entity_ModifiedByToAppUser                                 Entity[]                 @relation("Entity_ModifiedByToAppUser")
  Gender_Gender_CreatedByToAppUser                                  Gender[]                 @relation("Gender_CreatedByToAppUser")
  Gender_Gender_ModifiedByToAppUser                                 Gender[]                 @relation("Gender_ModifiedByToAppUser")
  IndustryType_IndustryType_CreatedByToAppUser                      IndustryType[]           @relation("IndustryType_CreatedByToAppUser")
  IndustryType_IndustryType_ModifiedByToAppUser                     IndustryType[]           @relation("IndustryType_ModifiedByToAppUser")
  InjusticeType_InjusticeType_CreatedByToAppUser                    InjusticeType[]          @relation("InjusticeType_CreatedByToAppUser")
  InjusticeType_InjusticeType_ModifiedByToAppUser                   InjusticeType[]          @relation("InjusticeType_ModifiedByToAppUser")
  Logbook                                                           Logbook[]
  MotiveReport_MotiveReport_CreatedByToAppUser                      MotiveReport[]           @relation("MotiveReport_CreatedByToAppUser")
  MotiveReport_MotiveReport_ModifiedByToAppUser                     MotiveReport[]           @relation("MotiveReport_ModifiedByToAppUser")
  NormalUser_NormalUser_NormalUserIDToAppUser                       NormalUser?              @relation("NormalUser_NormalUserIDToAppUser")
  NormalUser_NormalUser_CreatedByToAppUser                          NormalUser[]             @relation("NormalUser_CreatedByToAppUser")
  NormalUser_NormalUser_ModifiedByToAppUser                         NormalUser[]             @relation("NormalUser_ModifiedByToAppUser")
  NotificationSuggestion_NotificationSuggestion_CreatedByToAppUser  NotificationSuggestion[] @relation("NotificationSuggestion_CreatedByToAppUser")
  NotificationSuggestion_NotificationSuggestion_ModifiedByToAppUser NotificationSuggestion[] @relation("NotificationSuggestion_ModifiedByToAppUser")
  Parameter_Parameter_CreatedByToAppUser                            Parameter[]              @relation("Parameter_CreatedByToAppUser")
  Parameter_Parameter_ModifiedByToAppUser                           Parameter[]              @relation("Parameter_ModifiedByToAppUser")
  ParameterType_ParameterType_CreatedByToAppUser                    ParameterType[]          @relation("ParameterType_CreatedByToAppUser")
  ParameterType_ParameterType_ModifiedByToAppUser                   ParameterType[]          @relation("ParameterType_ModifiedByToAppUser")
  Report_Report_CheckedByToAppUser                                  Report[]                 @relation("Report_CheckedByToAppUser")
  Report_Report_CreatedByToAppUser                                  Report[]                 @relation("Report_CreatedByToAppUser")
  Report_Report_ModifiedByToAppUser                                 Report[]                 @relation("Report_ModifiedByToAppUser")
  Report_Report_ReportedByToAppUser                                 Report[]                 @relation("Report_ReportedByToAppUser")
  ReportState_ReportState_CreatedByToAppUser                        ReportState[]            @relation("ReportState_CreatedByToAppUser")
  ReportState_ReportState_ModifiedByToAppUser                       ReportState[]            @relation("ReportState_ModifiedByToAppUser")
  Sector_Sector_CreatedByToAppUser                                  Sector[]                 @relation("Sector_CreatedByToAppUser")
  Sector_Sector_ModifiedByToAppUser                                 Sector[]                 @relation("Sector_ModifiedByToAppUser")
  SuggestionBox_SuggestionBox_CheckedByToAppUser                    SuggestionBox[]          @relation("SuggestionBox_CheckedByToAppUser")
  SuggestionBox_SuggestionBox_CreatedByToAppUser                    SuggestionBox[]          @relation("SuggestionBox_CreatedByToAppUser")
  SuggestionBox_SuggestionBox_ModifiedByToAppUser                   SuggestionBox[]          @relation("SuggestionBox_ModifiedByToAppUser")
  SuggestionBox_SuggestionBox_SuggestedByToAppUser                  SuggestionBox[]          @relation("SuggestionBox_SuggestedByToAppUser")
  SuggestionState_SuggestionState_CreatedByToAppUser                SuggestionState[]        @relation("SuggestionState_CreatedByToAppUser")
  SuggestionState_SuggestionState_ModifiedByToAppUser               SuggestionState[]        @relation("SuggestionState_ModifiedByToAppUser")
  UrgentReport_UrgentReport_CreatedByToAppUser                      UrgentReport[]           @relation("UrgentReport_CreatedByToAppUser")
  UrgentReport_UrgentReport_ModifiedByToAppUser                     UrgentReport[]           @relation("UrgentReport_ModifiedByToAppUser")
  UserFavoriteBoycott_UserFavoriteBoycott_UserIDToAppUser           UserFavoriteBoycott[]    @relation("UserFavoriteBoycott_UserIDToAppUser")
  UserFavoriteBoycott_UserFavoriteBoycott_CreatedByToAppUser        UserFavoriteBoycott[]    @relation("UserFavoriteBoycott_CreatedByToAppUser")
  UserFavoriteBoycott_UserFavoriteBoycott_ModifiedByToAppUser       UserFavoriteBoycott[]    @relation("UserFavoriteBoycott_ModifiedByToAppUser")
  UserVotesBoycott_UserVotesBoycott_UserIDToAppUser                 UserVotesBoycott[]       @relation("UserVotesBoycott_UserIDToAppUser")
  UserVotesBoycott_UserVotesBoycott_CreatedByToAppUser              UserVotesBoycott[]       @relation("UserVotesBoycott_CreatedByToAppUser")
  UserVotesBoycott_UserVotesBoycott_ModifiedByToAppUser             UserVotesBoycott[]       @relation("UserVotesBoycott_ModifiedByToAppUser")
  UserVotesComment_UserVotesComment_UserIDToAppUser                 UserVotesComment[]       @relation("UserVotesComment_UserIDToAppUser")
  UserVotesComment_UserVotesComment_CreatedByToAppUser              UserVotesComment[]       @relation("UserVotesComment_CreatedByToAppUser")
  UserVotesComment_UserVotesComment_ModifiedByToAppUser             UserVotesComment[]       @relation("UserVotesComment_ModifiedByToAppUser")

  @@index([AccountStateID], map: "FK_AppUser_AccountState")
  @@index([CountryID], map: "FK_AppUser_Country")
  @@index([CreatedBy], map: "FK_AppUser_CreatedBy")
  @@index([GenderID], map: "FK_AppUser_Gender")
  @@index([ModifiedBy], map: "FK_AppUser_ModifiedBy")
}

model Boycott {
  BoycottID                           Int                   @id @default(autoincrement())
  Title                               String                @db.VarChar(200)
  CaseNumber                          Int?
  PublicationDate                     DateTime              @default(now()) @db.DateTime(0)
  LastUpdateDate                      DateTime?             @db.DateTime(0)
  LastCheckDate                       DateTime?             @db.DateTime(0)
  VotesInFavor                        Int                   @default(0)
  VotesAgainst                        Int                   @default(0)
  NumberFavorites                     Int                   @default(0)
  NumberComments                      Int                   @default(0)
  NumberReports                       Int                   @default(0)
  MongoDocumentId                     String?               @db.VarChar(100)
  DeletedByUser                       Boolean               @default(false)
  DeletedAt                           DateTime?             @db.DateTime(0)
  CreatedAt                           DateTime              @default(now()) @db.DateTime(0)
  CreatedBy                           Int?
  ModifiedAt                          DateTime?             @db.DateTime(0)
  ModifiedBy                          Int?
  CheckedBy                           Int?
  CreatorID                           Int
  BoycottStateID                      Int
  CountryID                           Int
  InjusticeTypeID                     Int
  EntityID                            Int
  BoycottState                        BoycottState          @relation(fields: [BoycottStateID], references: [BoycottStateID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Boycott_BoycottState")
  AppUser_Boycott_CheckedByToAppUser  AppUser?              @relation("Boycott_CheckedByToAppUser", fields: [CheckedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Boycott_CheckedBy")
  Country                             Country               @relation(fields: [CountryID], references: [CountryID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Boycott_Country")
  AppUser_Boycott_CreatedByToAppUser  AppUser?              @relation("Boycott_CreatedByToAppUser", fields: [CreatedBy], references: [UserID], map: "FK_Boycott_CreatedBy")
  AppUser_Boycott_CreatorIDToAppUser  AppUser               @relation("Boycott_CreatorIDToAppUser", fields: [CreatorID], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Boycott_Creator")
  Entity                              Entity                @relation(fields: [EntityID], references: [EntityID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Boycott_Entity")
  InjusticeType                       InjusticeType         @relation(fields: [InjusticeTypeID], references: [InjusticeTypeID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Boycott_InjusticeType")
  AppUser_Boycott_ModifiedByToAppUser AppUser?              @relation("Boycott_ModifiedByToAppUser", fields: [ModifiedBy], references: [UserID], map: "FK_Boycott_ModifiedBy")
  CommentBoycott                      CommentBoycott[]
  ReportBoycott                       ReportBoycott[]
  UrgentReport                        UrgentReport[]
  UserFavoriteBoycott                 UserFavoriteBoycott[]
  UserVotesBoycott                    UserVotesBoycott[]

  @@index([BoycottStateID], map: "FK_Boycott_BoycottState")
  @@index([CheckedBy], map: "FK_Boycott_CheckedBy")
  @@index([CountryID], map: "FK_Boycott_Country")
  @@index([CreatedBy], map: "FK_Boycott_CreatedBy")
  @@index([CreatorID], map: "FK_Boycott_Creator")
  @@index([EntityID], map: "FK_Boycott_Entity")
  @@index([InjusticeTypeID], map: "FK_Boycott_InjusticeType")
  @@index([ModifiedBy], map: "FK_Boycott_ModifiedBy")
}

model BoycottState {
  BoycottStateID                           Int       @id @default(autoincrement())
  StateName                                String    @unique(map: "StateName") @db.VarChar(100)
  CreatedAt                                DateTime  @default(now()) @db.DateTime(0)
  CreatedBy                                Int?
  ModifiedAt                               DateTime? @db.DateTime(0)
  ModifiedBy                               Int?
  Boycott                                  Boycott[]
  AppUser_BoycottState_CreatedByToAppUser  AppUser?  @relation("BoycottState_CreatedByToAppUser", fields: [CreatedBy], references: [UserID], map: "FK_BoycottState_CreatedBy")
  AppUser_BoycottState_ModifiedByToAppUser AppUser?  @relation("BoycottState_ModifiedByToAppUser", fields: [ModifiedBy], references: [UserID], map: "FK_BoycottState_ModifiedBy")

  @@index([CreatedBy], map: "FK_BoycottState_CreatedBy")
  @@index([ModifiedBy], map: "FK_BoycottState_ModifiedBy")
}

model CategoryEntity {
  CategoryEntityID                           Int       @id @default(autoincrement())
  CategoryName                               String    @unique(map: "CategoryName") @db.VarChar(100)
  CreatedAt                                  DateTime  @default(now()) @db.DateTime(0)
  CreatedBy                                  Int?
  ModifiedAt                                 DateTime? @db.DateTime(0)
  ModifiedBy                                 Int?
  AppUser_CategoryEntity_CreatedByToAppUser  AppUser?  @relation("CategoryEntity_CreatedByToAppUser", fields: [CreatedBy], references: [UserID], map: "FK_CategoryEntity_CreatedBy")
  AppUser_CategoryEntity_ModifiedByToAppUser AppUser?  @relation("CategoryEntity_ModifiedByToAppUser", fields: [ModifiedBy], references: [UserID], map: "FK_CategoryEntity_ModifiedBy")
  Entity                                     Entity[]

  @@index([CreatedBy], map: "FK_CategoryEntity_CreatedBy")
  @@index([ModifiedBy], map: "FK_CategoryEntity_ModifiedBy")
}

model CommentBoycott {
  CommentBoycottID                           Int                @id @default(autoincrement())
  Description                                String             @db.Text
  VotesInFavor                               Int                @default(0)
  VotesAgainst                               Int                @default(0)
  CommentDate                                DateTime           @default(now()) @db.DateTime(0)
  DeletedByUser                              Boolean            @default(false)
  DeletedAt                                  DateTime?          @db.DateTime(0)
  CreatedAt                                  DateTime           @default(now()) @db.DateTime(0)
  CreatedBy                                  Int?
  ModifiedAt                                 DateTime?          @db.DateTime(0)
  ModifiedBy                                 Int?
  CreatorID                                  Int
  BoycottID                                  Int
  CommentStateID                             Int
  Boycott                                    Boycott            @relation(fields: [BoycottID], references: [BoycottID], onDelete: NoAction, onUpdate: NoAction, map: "FK_CommentBoycott_Boycott")
  CommentState                               CommentState       @relation(fields: [CommentStateID], references: [CommentStateID], onDelete: NoAction, onUpdate: NoAction, map: "FK_CommentBoycott_CommentState")
  AppUser_CommentBoycott_CreatedByToAppUser  AppUser?           @relation("CommentBoycott_CreatedByToAppUser", fields: [CreatedBy], references: [UserID], map: "FK_CommentBoycott_CreatedBy")
  AppUser_CommentBoycott_CreatorIDToAppUser  AppUser            @relation("CommentBoycott_CreatorIDToAppUser", fields: [CreatorID], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_CommentBoycott_Creator")
  AppUser_CommentBoycott_ModifiedByToAppUser AppUser?           @relation("CommentBoycott_ModifiedByToAppUser", fields: [ModifiedBy], references: [UserID], map: "FK_CommentBoycott_ModifiedBy")
  ReportComment                              ReportComment[]
  UserVotesComment                           UserVotesComment[]

  @@index([BoycottID], map: "FK_CommentBoycott_Boycott")
  @@index([CommentStateID], map: "FK_CommentBoycott_CommentState")
  @@index([CreatedBy], map: "FK_CommentBoycott_CreatedBy")
  @@index([CreatorID], map: "FK_CommentBoycott_Creator")
  @@index([ModifiedBy], map: "FK_CommentBoycott_ModifiedBy")
}

model CommentState {
  CommentStateID                           Int              @id @default(autoincrement())
  StateName                                String           @unique(map: "StateName") @db.VarChar(50)
  CreatedAt                                DateTime         @default(now()) @db.DateTime(0)
  CreatedBy                                Int?
  ModifiedAt                               DateTime?        @db.DateTime(0)
  ModifiedBy                               Int?
  CommentBoycott                           CommentBoycott[]
  AppUser_CommentState_CreatedByToAppUser  AppUser?         @relation("CommentState_CreatedByToAppUser", fields: [CreatedBy], references: [UserID], map: "FK_CommentState_CreatedBy")
  AppUser_CommentState_ModifiedByToAppUser AppUser?         @relation("CommentState_ModifiedByToAppUser", fields: [ModifiedBy], references: [UserID], map: "FK_CommentState_ModifiedBy")

  @@index([CreatedBy], map: "FK_CommentState_CreatedBy")
  @@index([ModifiedBy], map: "FK_CommentState_ModifiedBy")
}

model Continent {
  ContinentID                           Int       @id @default(autoincrement())
  ContinentName                         String    @db.VarChar(100)
  CreatedAt                             DateTime  @default(now()) @db.DateTime(0)
  CreatedBy                             Int?
  ModifiedAt                            DateTime? @db.DateTime(0)
  ModifiedBy                            Int?
  AppUser_Continent_CreatedByToAppUser  AppUser?  @relation("Continent_CreatedByToAppUser", fields: [CreatedBy], references: [UserID], map: "FK_Continent_CreatedBy")

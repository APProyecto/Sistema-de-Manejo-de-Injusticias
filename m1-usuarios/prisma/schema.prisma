model Country {
  CountryID                           Int       @id @default(autoincrement())
  CountryName                         String    @unique(map: "CountryName") @db.VarChar(100)
  CreatedAt                           DateTime  @default(now()) @db.DateTime(0)
  CreatedBy                           Int?
  ModifiedAt                          DateTime? @db.DateTime(0)
  ModifiedBy                          Int?
  ContinentID                         Int
  AppUser_AppUser_CountryIDToCountry  AppUser[] @relation("AppUser_CountryIDToCountry")
  Boycott                             Boycott[]
  Continent                           Continent @relation(fields: [ContinentID], references: [ContinentID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Country_Continent")
  AppUser_Country_CreatedByToAppUser  AppUser?  @relation("Country_CreatedByToAppUser", fields: [CreatedBy], references: [UserID], map: "FK_Country_CreatedBy")
  AppUser_Country_ModifiedByToAppUser AppUser?  @relation("Country_ModifiedByToAppUser", fields: [ModifiedBy], references: [UserID], map: "FK_Country_ModifiedBy")

  @@index([ContinentID], map: "FK_Country_Continent")
  @@index([CreatedBy], map: "FK_Country_CreatedBy")
  @@index([ModifiedBy], map: "FK_Country_ModifiedBy")
}

model Entity {
  EntityID                           Int            @id @default(autoincrement())
  EntityName                         String         @db.VarChar(150)
  MongoDocumentID                    String?        @db.VarChar(255)
  Description                        String?        @db.Text
  NumberBoycotts                     Int            @default(0)
  CreatedAt                          DateTime       @default(now()) @db.DateTime(0)
  CreatedBy                          Int?
  ModifiedAt                         DateTime?      @db.DateTime(0)
  ModifiedBy                         Int?
  CategoryEntityID                   Int
  IndustryTypeID                     Int?
  SectorID                           Int?
  Boycott                            Boycott[]
  CategoryEntity                     CategoryEntity @relation(fields: [CategoryEntityID], references: [CategoryEntityID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Entity_CategoryEntity")
  AppUser_Entity_CreatedByToAppUser  AppUser?       @relation("Entity_CreatedByToAppUser", fields: [CreatedBy], references: [UserID], map: "FK_Entity_CreatedBy")
  IndustryType                       IndustryType?  @relation(fields: [IndustryTypeID], references: [IndustryTypeID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Entity_IndustryType")
  AppUser_Entity_ModifiedByToAppUser AppUser?       @relation("Entity_ModifiedByToAppUser", fields: [ModifiedBy], references: [UserID], map: "FK_Entity_ModifiedBy")
  Sector                             Sector?        @relation(fields: [SectorID], references: [SectorID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Entity_Sector")

  @@unique([EntityName, CategoryEntityID], map: "UQ_Entity_Name_Category")
  @@index([CategoryEntityID], map: "FK_Entity_CategoryEntity")
  @@index([CreatedBy], map: "FK_Entity_CreatedBy")
  @@index([IndustryTypeID], map: "FK_Entity_IndustryType")
  @@index([ModifiedBy], map: "FK_Entity_ModifiedBy")
  @@index([SectorID], map: "FK_Entity_Sector")
}

model Gender {
  GenderID                           Int       @id @default(autoincrement())

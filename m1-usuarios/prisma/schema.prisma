  Entity                                   Entity[]
  AppUser_IndustryType_CreatedByToAppUser  AppUser?  @relation("IndustryType_CreatedByToAppUser", fields: [CreatedBy], references: [UserID], map: "FK_IndustryType_CreatedBy")
  AppUser_IndustryType_ModifiedByToAppUser AppUser?  @relation("IndustryType_ModifiedByToAppUser", fields: [ModifiedBy], references: [UserID], map: "FK_IndustryType_ModifiedBy")

  @@index([CreatedBy], map: "FK_IndustryType_CreatedBy")
  @@index([ModifiedBy], map: "FK_IndustryType_ModifiedBy")
}


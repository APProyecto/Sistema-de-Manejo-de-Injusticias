{
  "name": "m0-base-datos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "mysql:pull": "prisma db pull --schema=prisma/mysql/schema.prisma",
    "mysql:generate": "prisma generate --schema=prisma/mysql/schema.prisma",
    "mysql:studio": "prisma studio --schema=prisma/mysql/schema.prisma",
    "mongo:push": "prisma db push --schema=prisma/mongodb/schema.prisma",
    "mongo:generate": "prisma generate --schema=prisma/mongodb/schema.prisma",
    "mongo:studio": "prisma studio --schema=prisma/mongodb/schema.prisma",
    "mysql:test": "tsx src/testMysql.ts",
    "mongo:test" : "tsx src/testMongo.ts",
    "generate": "npm run mysql:generate && npm run mongo:generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "mongodb": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "prisma": "6.19.0",
    "tsx": "^4.22.1",
    "typescript": "^5.0.3"
  }
}
